# Maintainer: Paolo Bossi <pbossi86@gmail.com>
pkgname=harbor
pkgver=1.0.0
pkgrel=1
pkgdesc="A Custom Stremio Client Built for Adventure"
arch=('x86_64')
url="https://github.com/Paolo86cripple/harbor"
license=('MIT')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'libappindicator-gtk3'
    'librsvg'
    'patchelf'
    'mpv'
    'ffmpeg'
    'yt-dlp'
    'openssl'
    'file'
    'curl'
    'wget'
)
makedepends=(
    'git'
    'nodejs'
    'pnpm'
    'rust'
    'wasm-pack'
    'base-devel'
)
source=("$pkgname::git+https://github.com/Paolo86cripple/harbor.git")
sha256sums=('SKIP')
# -lto: makepkg mette -flto in CFLAGS; ring compila oggetti C/asm in bitcode GIMPLE
# che ld.lld non legge -> "undefined symbol: ring_core_0_17_14__*"
options=('!lto' '!debug' '!strip')

build() {
    cd "$srcdir/$pkgname"

    # Difesa in profondità: niente LTO negli oggetti C compilati dai build.rs (ring, aws-lc-sys)
    export CFLAGS="${CFLAGS//-flto=auto/}"; export CFLAGS="${CFLAGS//-flto/}"
    export CXXFLAGS="${CXXFLAGS//-flto=auto/}"; export CXXFLAGS="${CXXFLAGS//-flto/}"
    export LDFLAGS="${LDFLAGS//-flto=auto/}"; export LDFLAGS="${LDFLAGS//-flto/}"
    export CC=gcc CXX=g++ AR=ar

    pnpm install --frozen-lockfile
    pnpm run setup
    pnpm tauri build --bundles deb
}

package() {
    cd "$srcdir/$pkgname"

    # Tauri lascia il contenuto già spacchettato del .deb in bundle/deb/<nome>/data
    local data_dir
    data_dir=$(find src-tauri/target/release/bundle/deb -maxdepth 2 -type d -name data | head -n 1)
    if [ -n "$data_dir" ]; then
        cp -a "$data_dir/." "$pkgdir/"
        # yt-dlp/ffmpeg/ffprobe sono già forniti dai pacchetti di sistema (dipendenze)
        rm -f "$pkgdir"/usr/bin/{yt-dlp,ffmpeg,ffprobe}
    fi

    # Il binario principale deve sempre esserci
    [ -x "$pkgdir/usr/bin/harbor" ] || install -Dm755 "src-tauri/target/release/harbor" "$pkgdir/usr/bin/harbor"

    # Fallback: crea manualmente il file .desktop se non presente
    if [ ! -f "$pkgdir/usr/share/applications/harbor.desktop" ]; then
        install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/harbor.desktop" <<EOF
[Desktop Entry]
Name=Harbor
Comment=A Custom Stremio Client
Exec=harbor
Icon=harbor
Terminal=false
Type=Application
Categories=AudioVideo;Player;
EOF
    fi

    # Installa l'icona se non già inclusa
    if [ ! -f "$pkgdir/usr/share/icons/hicolor/256x256/apps/harbor.png" ] && [ -f "src-tauri/icons/icon.png" ]; then
        install -Dm644 "src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/harbor.png"
    fi
}
